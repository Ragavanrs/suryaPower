# Surya Power — Environment Variables
# Copy this file to .env.local and fill in the values for local development.
# Never commit .env.local or any file containing real secrets.

# ─── API ────────────────────────────────────────────────────────────────────
# Base URL for the backend API. Defaults to /api (same-origin proxy).
REACT_APP_API_URL=/api

# ─── Analytics ──────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable analytics.
REACT_APP_GA_MEASUREMENT_ID=

# ─── Site ───────────────────────────────────────────────────────────────────
# Public-facing site URL — used for canonical links and OG tags.
REACT_APP_SITE_URL=https://suryapower.in
